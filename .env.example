# Copy to .env.local and fill in real values. .env.local is gitignored.

# Shared password for the team dashboard login gate.
DASHBOARD_PASSWORD=

# Secret used to sign the session cookie (HMAC-SHA256). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# n8n "WhatsApp Dashboard API" workflow — base URL and bearer token.
N8N_DASHBOARD_URL=
N8N_DASHBOARD_TOKEN=
